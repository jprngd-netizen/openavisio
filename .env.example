# Required
APP_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
POSTGRES_USER=openavisio
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# One-time token required by the first-run setup wizard (POST /organization/init).
# setup.sh generates and prints this. Enforced when ENVIRONMENT != development.
BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Shared secret for backend→aiservice calls (#46). Same value for backend + aiservice.
AISERVICE_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# Database (auto-built from POSTGRES_* in docker-compose; set directly for local dev)
# DATABASE_URL=postgresql+asyncpg://openavisio:password@localhost:5432/vaultdb

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Service
AI_BACKEND=mock
# AI_BACKEND=ollama|vllm|mistral

# Ollama (leave empty to disable)
OLLAMA_URL=
# Optional: pin vision OCR / embeddings to their own Ollama instance (own GPU),
# so a big LLM never has to share VRAM with them. Both fall back to OLLAMA_URL.
# The URL pool is round-robin, so do NOT put several role-specific hosts in
# OLLAMA_URL - split them here instead.
OLLAMA_VISION_URL=
OLLAMA_EMBED_URL=
OLLAMA_MODEL=alibayram/medgemma:27b
OLLAMA_MODELS=alibayram/medgemma:27b,alibayram/medgemma:4b,qwen3-vl:8b,qwen3:14b,nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CLASSIFY_MODEL=qwen3:14b
OLLAMA_EXTRACT_MODEL=alibayram/medgemma:27b
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_CHAT_MODEL=alibayram/medgemma:27b

# vLLM (optional)
VLLM_URL=
VLLM_MODEL=

# Mistral (optional)
MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_CLASSIFY_MODEL=
MISTRAL_EXTRACT_MODEL=
MISTRAL_CHAT_MODEL=

# Document processing
DOCUMENT_STORAGE_PATH=./data/documents

# Background jobs
EMBEDDING_SCHEDULER_CRON=*/15 * * * *
EMBEDDING_SCHEDULER_BATCH_SIZE=50

# CORS (comma-separated origins for production)
CORS_ORIGINS=http://localhost:3000

# Licensing (optional — leave empty to use the embedded dev key for testing)
# In production, set this to the RSA-2048 public key (PEM) provided by OpenAvisio
# LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Production only
DOMAIN=yourdomain.com

# Frontend
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Passkeys / WebAuthn (must match the domain your frontend is served from)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=OpenAvisio
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Backups (deploy/backup, ADR-022 / ADR-031) ---
# age PUBLIC key. Backups are encrypted to it; the private key must live
# OUT-OF-BAND (password manager / paper) and never on the server. Losing it
# makes every backup unreadable. Generate: age-keygen
AGE_PUBKEY=
# Host directory the dumps land in. Sync it OFF this machine — a backup on the
# same disk as the database is not a backup.
BACKUP_DIR=/opt/openavisio-backups
BACKUP_HOUR=3
RETENTION_CLINICAL_DAYS=90
# Keep short: this is what lets crypto-shredding reach backups (ADR-031).
RETENTION_KEYSTORE_DAYS=7

# Shows the "preview — not ready for production use" banner. true on test instances.
PREVIEW_BANNER=false

# Memed — Sinapse Prescrição integration
# Get these from your Memed partner dashboard (https://doc.memed.com.br/docs/obter-credenciais)
MEMED_API_URL=https://api.memed.com.br
MEMED_SCRIPT_URL=https://app.memed.com.br/sinapse-prescricao.js
MEMED_API_KEY=
MEMED_SECRET_KEY=
MEMED_ENVIRONMENT=integration  # "integration" | "production" — validated by production guard
MEMED_EMISSION_POLICY=linked_user  # "linked_user" | "any_admin" — who can issue prescriptions

# Deployment mode — only "personal" is implemented in this version.
# "clinic" and "multi_tenant" are reserved and rejected explicitly.
DEPLOYMENT_MODE=personal

# Memed — postMessage origin validation (frontend, NEXT_PUBLIC_*)
# Comma-separated list of allowed iframe origins for the Memed Sinapse Prescrição module.
# In homolog, set to the known iframe origin (e.g. https://app.memed.com.br).
# In production, set when the partner origin is verified.
NEXT_PUBLIC_MEMED_ALLOWED_ORIGINS=
# When true, messages from origins NOT in the allowlist are silently ignored.
# When false/absent, unknown origins are logged but messages are still processed.
# Default: false (log-only, no enforcement).
NEXT_PUBLIC_MEMED_ENFORCE_ORIGIN=false
